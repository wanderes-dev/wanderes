# Copy this file to .env and adjust values. Never commit the real .env file.

DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# The one canonical hostname used to build canonical/Open Graph/sitemap/
# robots.txt URLs (2026-09-03, SEO prep) - deliberately separate from
# DJANGO_ALLOWED_HOSTS, which can list several real hostnames the app
# actually serves. Defaults to the real production domain, so this only
# needs setting if that domain ever changes. www, not the bare apex - see
# config/settings/base.py's own comment on this setting for why (a real
# outage, not an arbitrary choice).
# SITE_DOMAIN=www.wanderes.com

# Hostnames "db" and "redis" match the Docker Compose service names.
# If running Django outside Docker, replace them with "localhost".
DATABASE_URL=postgres://wanderes:wanderes@db:5432/wanderes
REDIS_URL=redis://redis:6379/0

CELERY_TASK_ALWAYS_EAGER=False

# AI provider (Phase 2 decision: OpenAI). Get a key at https://platform.openai.com/
# Required for ai.provider.get_ai_provider() to actually work at runtime -
# without it, OpenAIProvider raises ImproperlyConfigured with this same hint.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Flight provider (2026-09-02: interface scaffolded ahead of a concrete
# adapter - see documentation/DECISIONS_PENDING.md §4). KAYAK's API needs
# manual business approval with no public docs until then, so
# integrations/flights/kayak.py is a deliberate skeleton, not a working
# adapter yet. Leave this unset until it's filled in -
# get_flight_provider() raises a clear ImproperlyConfigured error rather
# than silently doing nothing if something tries to use it before then.
# FLIGHT_PROVIDER=kayak

# Hotel provider (2026-09-04: interface scaffolded ahead of a concrete
# adapter - see documentation/DECISIONS_PENDING.md §4). Booking.com's
# Affiliate Partner Program is application-reviewed and its real feed
# format isn't public until approved, so integrations/hotels/booking_com.py
# is a deliberate skeleton, not a working adapter yet. Leave this unset
# until it's filled in - get_hotel_provider() raises a clear
# ImproperlyConfigured error rather than silently doing nothing if
# something tries to use it before then.
# HOTEL_PROVIDER=booking_com

# Google OAuth login (2026-09-03: code scaffolded, real credentials still
# needed - see documentation/DECISIONS_PENDING.md). Both blank, the
# "Continue with Google" button simply doesn't render (checked live, not
# just assumed - see core.context_processors.site_meta's
# google_oauth_configured flag) rather than showing a broken button.
#
# To get real values: console.cloud.google.com > APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application.
# Authorized redirect URI must be exactly:
#   https://www.wanderes.com/accounts/google/login/callback/ (production)
#   http://localhost:8000/accounts/google/login/callback/ (local dev)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email (2026-09-04: password reset via emailed token, code fully wired,
# real SMTP credentials still needed). All blank, the "Forgot your
# password?" link simply doesn't render (same pattern as
# GOOGLE_OAUTH_CLIENT_ID above - checked live, not just assumed - see
# core.context_processors.site_meta's email_configured flag) rather than
# showing a link that would silently fail to deliver anything. Deliberately
# provider-agnostic - any real SMTP provider works (SendGrid, Mailgun, AWS
# SES's SMTP interface, Postmark, a Gmail account, etc.), the choice is
# yours, not hardcoded here.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Wanderes <noreply@wanderes.com>
